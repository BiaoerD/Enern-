#!name=网上国网签到
#!desc=网上国网Cookie获取与自动签到（每天8：30执行）

[Script]
网上国网 Cookie = type=http-request, pattern=^https?:\/\/csc-service\.sgcc\.com\.cn:28630\/.+\/member\/, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/sgcc/sgcc.cookie.js, requires-body=true, max-size=0

网上国网签到 = type=cron, cronexp=30 8 * * *, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/sgcc/sgcc.js, timeout=60

[MITM]
hostname = %APPEND% csc-service.sgcc.com.cn
